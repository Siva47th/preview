# Freewheel Server Database Environment Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Connection URL Example:
# postgres://username:password@localhost:5432/database_name
# For Supabase / Remote DB: postgres://postgres.xyz:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/freewheel_db
